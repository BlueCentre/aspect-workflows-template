load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("@build_bazel_rules_swift//swift:swift_test.bzl", "swift_test")
load("//swift:defs.bzl", "swift_binary")

swift_library(
    name = "greeting",
    srcs = ["Greeting.swift"],
    module_name = "Greeting",
    visibility = ["//visibility:public"],
)

# Uses the //swift:defs.bzl wrapper so the hermetic Swift runtime is staged on Linux.
swift_binary(
    name = "hello",
    srcs = ["main.swift"],
    deps = [":greeting"],
)

swift_test(
    name = "hello_test",
    srcs = ["GreetingTests.swift"],
    deps = [":greeting"],
)
