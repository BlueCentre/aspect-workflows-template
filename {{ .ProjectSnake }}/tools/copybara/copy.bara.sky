{{ end }}{{ end }}# tools/copybara/copy.bara.sky
#
# Copybara configuration syncing each monorepo component subfolder with its
# standalone GitHub repo. Each component picks ONE of two sync SHAPES via the
# per-component `is_one_way` knob (the scaffold seeds the default for every
# component from the `copybara_one_way` answer; you can flip individual
# components afterwards):
#
#   * BIDIRECTIONAL (is_one_way=False) -- both repos are writable-authoritative;
#     on-push peer sync. Generates the pair:
#       - export_<comp>  : monorepo <comp>/ -> standalone root  (push to `main`)
#       - import_<comp>  : standalone root  -> monorepo <comp>/ (push to `main`)
#
#   * ONE-WAY w/ PR-IMPORT (is_one_way=True) -- the monorepo is the single source
#     of truth; the standalone is an EXPORT-ONLY mirror. Generates:
#       - export_<comp>    : monorepo <comp>/ -> standalone root (push to `main`)
#       - import_pr_<comp> : a labelled standalone PR -> a MONOREPO PR under
#                            <comp>/ (CHANGE_REQUEST) for human review + merge.
#     There is deliberately NO push-to-main import_<comp> for one-way components.
#     Converging on one-way removes the #1 drift risk of two
#     writable-authoritative copies (use it unless you genuinely need both repos
#     writable).
#
# (`-` in a component name becomes `_` in the workflow name, e.g.
#  export_my_service / import_pr_my_service.) The first run against a fresh
#  destination (no rev-id baseline yet) needs a one-time `--force` to seed the
#  baseline; normal runs use --ignore-noop and rely on the rev-id labels below.
#
# ---------------------------------------------------------------------------
# LOOP PREVENTION (applies to BOTH shapes)
# ---------------------------------------------------------------------------
# An EXPORTed change must not bounce back as an IMPORT (and vice-versa), or the
# two repos ping-pong forever. We prevent this with two cooperating mechanisms
# (BOTH required):
#
#   1. Distinct per-direction rev-id labels.
#      By default Copybara stamps every migrated change with `GitOrigin-RevId`.
#      If BOTH directions used that default label they could not tell their own
#      footprint apart from the peer's. Instead each direction stamps the
#      destination with its OWN label (see `experimental_custom_rev_id` below):
#        - export        stamps `MONOREPO_REV_ID`   (change came FROM the monorepo)
#        - import        stamps `<COMPONENT>_REV_ID` (change came FROM the standalone)
#        - import_pr     stamps `<COMPONENT>_REV_ID` (SAME label as the bidi
#          import: a PR-imported change is still standalone-origin, so it carries
#          the component's import label -- this lets export_<comp>'s UNCHANGED
#          skip-guard drop it instead of re-exporting it. The one-way loop guard
#          reuses the bidi loop guard verbatim.)
#
#      LABEL SCOPING (why these names are safe across components):
#        * The EXPORT label is the same literal `MONOREPO_REV_ID` for every
#          component because each export stamps a DIFFERENT standalone repo; a
#          component's import only ever sees its own export's stamps (in its own
#          standalone), so there is no cross-component collision.
#        * The IMPORT label MUST be unique per component (`<COMPONENT>_REV_ID`)
#          because every import stamps the SHARED monorepo; a per-component label
#          lets each export's skip-guard recognise exactly its own component's
#          imported commits.
#
#   2. A dynamic transform that SKIPs (no-op) any change already carrying the
#      OTHER direction's label. `ctx.find_label(name)` returns the label value
#      or None; if the peer's label is present the change originated from the
#      peer, so we `core.fail_with_noop(...)` to drop it instead of migrating
#      it back. This NOOP (exit code 4) is what breaks the loop.
#
#      For a one-way component the guard pairing is:
#        - export_<comp>    skips changes carrying <COMPONENT>_REV_ID (PR-imported), and
#        - import_pr_<comp> skips changes carrying MONOREPO_REV_ID (export-origin).
#      i.e. EXACTLY the same guard pairing the bidi import_<comp> used -- so
#      switching a component to one-way does NOT change its export behaviour.
#
# COPYBARA VERSION NOTE (important for upgrades):
#   This config was designed for `olivr/copybara` (build date 2023-01,
#   "Unknown version"). That build:
#     - exposes the parameter as `experimental_custom_rev_id` (NOT the newer
#       `custom_rev_id` -- the rename landed in Copybara ~late-2023), and
#     - enforces the older label format `[A-Z][A-Z_0-9]{1,30}_REV_ID`
#       (hence `MONOREPO_REV_ID` / `<COMPONENT>_REV_ID`; the modern `Xxx-RevId`
#       form is NOT accepted by this build).
#   On a CURRENT Copybara, make exactly these two edits (logic is identical):
#     - rename `experimental_custom_rev_id` -> `custom_rev_id`, and
#     - the `_REV_ID` labels keep working (modern format is a superset).
#
#   PINNED-IMAGE GOTCHAS (one-way `import_pr_<comp>` only -- learned the hard way;
#   the export/bidi-import paths are unaffected). The import workflow
#   (copybara-import-pr.yaml) works around all three:
#     a. The image ENTRYPOINT is env-driven and IGNORES CLI args
#        (google/copybara#158): it runs `java -jar copybara.jar $COPYBARA_OPTIONS
#        $COPYBARA_SUBCOMMAND $COPYBARA_CONFIG $COPYBARA_WORKFLOW $COPYBARA_SOURCEREF`.
#        The PR number is therefore passed via COPYBARA_SOURCEREF, NOT positionally.
#     b. This build does NOT resolve copybara label templates like
#        `${GITHUB_PR_NUMBER}` / `${GITHUB_PR_TITLE}` inside pr_branch/title/body
#        (it leaves them literal, mangling the branch name). So those fields use a
#        `@@PR_NUMBER@@` placeholder that the import workflow sed-substitutes with
#        the real PR number into a throwaway config copy before each run.
#     c. `actions/checkout` injects an http extraheader (the workflow GITHUB_TOKEN)
#        that shadows the App-token credential store for host-side `git push`, so
#        the import workflow sets `persist-credentials: false`.
#
# HISTORY MODE (ITERATIVE -- required; do NOT use SQUASH):
#   We migrate one commit at a time so the skip guard runs PER COMMIT, dropping
#   only the peer-origin commits while migrating the genuine ones. SQUASH is WRONG
#   here: it evaluates the skip guard over the labels of the WHOLE squashed range,
#   so a range that merely *contains* a peer-origin commit is skipped ENTIRELY --
#   including genuine changes batched with it. import_pr uses ITERATIVE too:
#   CHANGE_REQUEST consumes the PR's commits and the per-commit guard still drops
#   any export-origin commit in the range.
#
# AUTH SPLIT (differs by direction):
#   * export_<comp> (push to standalone main): the monorepo is read over HTTPS via
#     the workflow GITHUB_TOKEN (this repo only); each standalone is WRITTEN over
#     SSH using that component's write deploy key (<COMPONENT>_SYNC_SSH_KEY,
#     provisioned by infrastructure/pulumi/copybara_sync). An HTTPS credential
#     store and an SSH key both mount with no URL rewriting, so the two schemes
#     coexist, selected per URL. The bidi import_<comp> uses the same split.
#   * import_pr_<comp> (labelled standalone PR -> monorepo PR): git.github_pr_* are
#     GitHub REST endpoints, reachable ONLY over HTTPS, so no SSH key is used. Both
#     repos are authenticated by a single SHORT-LIVED GitHub App installation token
#     (the copybara-sync App; secrets.SYNC_APP_ID / secrets.SYNC_APP_PRIVATE_KEY,
#     minted per run by actions/create-github-app-token, scoped to <comp> + this
#     monorepo with Contents+Pull-requests:write). The App must be granted
#     Pull-requests:write and installed on the monorepo + every one-way mirror.
#     See copybara-import-pr.yaml.
#
# See docs/copybara-bidi-sync.md (bidirectional) and
# docs/copybara-oneway-sync.md (one-way PR-import) for the onboarding runbooks.

# EDIT: set your GitHub organization/user that owns both this monorepo and the
# standalone repos. See the onboarding runbooks for details.
GITHUB_ORG = "YOUR_GITHUB_ORG"  # EDIT: your GitHub org (see docs/copybara-*-sync.md)

MONOREPO = "https://github.com/" + GITHUB_ORG + "/{{ .ProjectKebab }}.git"
STANDALONE_SSH_PREFIX = "git@github.com:" + GITHUB_ORG + "/"
AUTHOR = "{{ .Project }} Sync <sync@example.com>"

# The EXPORT label, shared across components (stamped on each separate standalone
# repo -- see LABEL SCOPING above). Format constrained by the pinned Copybara
# build to `[A-Z][A-Z_0-9]{1,30}_REV_ID`.
MONOREPO_REV_ID = "MONOREPO_REV_ID"

# Monorepo-only files: gazelle-generated Bazel BUILD files live throughout each
# component subtree. They exist ONLY in the monorepo; the sync must never export
# them to the standalone nor delete them on import. The explicit top-level entries
# belt-and-suspender the `**/` form in case a given Copybara build does not treat
# `**` as matching zero path segments.
def _monorepo_only(component):
    return [
        component + "/**/BUILD",
        component + "/**/BUILD.bazel",
        component + "/BUILD",
        component + "/BUILD.bazel",
    ]

# Source of truth for which components are synced and their per-component knobs.
#   name              : monorepo subfolder name == standalone repo name
#   standalone_rev_id : the per-component IMPORT label (must be unique; see above)
#   standalone_only   : files that exist ONLY in the standalone repo and must
#                       never cross into the monorepo nor be deleted by export.
#                       The dispatch workflow is standalone-only for every
#                       component; an npm component also wants "package-lock.json".
#   is_one_way        : True  -> monorepo is source of truth; emit export_<comp>
#                                + import_pr_<comp> (CHANGE_REQUEST), no bidi
#                                push-to-main import.
#                       False -> bidirectional export+import pair.
#
# To add a component later, append a dict here and follow the onboarding runbook
# (docs/copybara-bidi-sync.md §8f or docs/copybara-oneway-sync.md).
COMPONENTS = [
{{- range $c := splitList "," .Scaffold.copybara_components }}{{- $t := trim $c }}{{- if $t }}
    {"name": "{{ $t }}", "standalone_rev_id": "{{ toUpper (replace "-" "_" $t) }}_REV_ID", "standalone_only": [".github/workflows/sync-to-monorepo.yaml"], "is_one_way": {{ if $.Scaffold.copybara_one_way }}True{{ else }}False{{ end }}},
{{- end }}{{- end }}
]

def _make_skip_guard(workflow_name, peer_label, origin_desc):
    """Return a dynamic-transform impl that NO-OPs any change already carrying
    the peer direction's rev-id label (i.e. a change the peer sync brought in),
    breaking the export<->import loop. The factory captures `peer_label` per call
    so each generated workflow checks exactly its own peer's label.
    """

    def _guard(ctx):
        if ctx.find_label(peer_label):
            core.fail_with_noop(
                workflow_name + ": skipping change that originated from " +
                origin_desc + " (carries " + peer_label + ").",
            )

    return _guard

# Generate the workflows for every component (top-level comprehension, not a
# `for` -- Copybara's Starlark forbids top-level `for` STATEMENTS).
def _define_component(_c):
    _name = _c["name"]
    _wf = _name.replace("-", "_")
    _standalone = STANDALONE_SSH_PREFIX + _name + ".git"
    _standalone_rev_id = _c["standalone_rev_id"]
    _standalone_only = _c["standalone_only"]
    _monorepo_only_files = _monorepo_only(_name)
    _is_one_way = _c.get("is_one_way", False)

    # Export: <monorepo>/<name>/  ->  <standalone>/<name> (repo root).
    # IDENTICAL for bidirectional and one-way components -- the export side is
    # never touched by the one-way shape, preserving the live export baseline.
    core.workflow(
        name = "export_" + _wf,
        origin = git.origin(
            url = MONOREPO,
            ref = "main",
        ),
        destination = git.destination(
            url = _standalone,
            fetch = "main",
            push = "main",
        ),
        # Component subtree minus the monorepo-only Bazel BUILD files.
        origin_files = glob([_name + "/**"], exclude = _monorepo_only_files),
        # Manage all standalone files EXCEPT the standalone-only ones (the sync
        # must never delete the dispatch workflow or an npm lockfile).
        destination_files = glob(["**"], exclude = _standalone_only),
        authoring = authoring.pass_thru(default = AUTHOR),
        mode = "ITERATIVE",
        # Stamp the monorepo's own rev-id, and drop any change the import
        # direction brought in (carries the per-component standalone label).
        experimental_custom_rev_id = MONOREPO_REV_ID,
        transformations = [
            core.dynamic_transform(impl = _make_skip_guard(
                "export_" + _wf,
                _standalone_rev_id,
                "the standalone " + _name + " repo",
            )),
            # Strip the `<name>/` prefix so the component lands at the repo root.
            core.move(_name, ""),
        ],
    )

    if _is_one_way:
        # One-way PR-import: a labelled PR on <standalone>/<name> becomes a
        # MONOREPO PR under <name>/ for human review + merge. Monorepo is the
        # single source of truth; nothing is pushed to monorepo main here.
        #
        # LOOP GUARD: stamp the component's import label (_standalone_rev_id) so
        # export_<name>'s UNCHANGED skip-guard (which drops _standalone_rev_id)
        # refuses to bounce the merged PR-import back out. The guard here drops
        # any export-origin change (carries MONOREPO_REV_ID) so an exported
        # change can never be re-imported.
        core.workflow(
            name = "import_pr_" + _wf,
            origin = git.github_pr_origin(
                url = _standalone,
                use_merge = False,
                required_labels = ["import-to-monorepo"],
            ),
            destination = git.github_pr_destination(
                url = MONOREPO,
                destination_ref = "main",
                # @@PR_NUMBER@@ is the ORIGIN (standalone) PR number. The pinned
                # 2023-01 copybara image does NOT resolve copybara label templates
                # like ${GITHUB_PR_NUMBER}/${GITHUB_PR_TITLE} in these fields (it
                # leaves them literal, mangling the branch), so the import workflow
                # sed-substitutes @@PR_NUMBER@@ with the real PR number into a
                # throwaway config copy before invoking copybara. The branch is
                # per-component (<name>-import-pr-<N>) so two components' imports of
                # the same PR number never collide on one branch.
                pr_branch = _name + "-import-pr-@@PR_NUMBER@@",
                # Static, self-identifying title (the contributor's commit message
                # carries the detail; ${GITHUB_PR_TITLE} also does not resolve here).
                title = "[" + _name + " import] " + _name + "#@@PR_NUMBER@@",
                # Body footer carries the standalone repo + PR ref so the post-merge
                # auto-close workflow (copybara-import-pr-close.yaml) can find and
                # close the right mirror PR after the monorepo PR merges. NOTE: a
                # bare GitHub trailer cannot auto-close across repos; closure is done
                # explicitly by that workflow, not by GitHub.
                body = "Imported from " + GITHUB_ORG + "/" + _name + "#@@PR_NUMBER@@ via Copybara.\n\nMirror-Of: " + GITHUB_ORG + "/" + _name + "#@@PR_NUMBER@@\nMirror-Pr-Number: @@PR_NUMBER@@",
            ),
            # Standalone-only files must never be imported into the Bazel monorepo.
            origin_files = glob(["**"], exclude = _standalone_only),
            # Manage the monorepo's <name>/ EXCEPT the monorepo-only Bazel BUILD
            # files so the sync never deletes them.
            destination_files = glob([_name + "/**"], exclude = _monorepo_only_files),
            authoring = authoring.pass_thru(default = AUTHOR),
            mode = "ITERATIVE",
            # Stamp the standalone's per-component rev-id (NOT MONOREPO_REV_ID):
            # PR-imported commits are standalone-origin; export's skip-guard drops
            # _standalone_rev_id, breaking the loop.
            experimental_custom_rev_id = _standalone_rev_id,
            transformations = [
                core.dynamic_transform(impl = _make_skip_guard(
                    "import_pr_" + _wf,
                    MONOREPO_REV_ID,
                    "the {{ .ProjectKebab }} monorepo export",
                )),
                # Re-add the `<name>/` prefix so the standalone root lands under the
                # component directory in the monorepo.
                core.move("", _name),
            ],
        )
    else:
        # Bidirectional import: <standalone>/<name> (root) -> monorepo <name>/.
        core.workflow(
            name = "import_" + _wf,
            origin = git.origin(
                url = _standalone,
                ref = "main",
            ),
            destination = git.destination(
                url = MONOREPO,
                fetch = "main",
                push = "main",
            ),
            # Standalone-only files must never be imported into the Bazel monorepo.
            origin_files = glob(["**"], exclude = _standalone_only),
            # Manage the monorepo's <name>/ EXCEPT the monorepo-only Bazel BUILD
            # files so the sync never deletes them.
            destination_files = glob([_name + "/**"], exclude = _monorepo_only_files),
            authoring = authoring.pass_thru(default = AUTHOR),
            mode = "ITERATIVE",
            # Stamp the standalone's own per-component rev-id, and drop any change
            # the export direction pushed out (carries the monorepo label).
            experimental_custom_rev_id = _standalone_rev_id,
            transformations = [
                core.dynamic_transform(impl = _make_skip_guard(
                    "import_" + _wf,
                    MONOREPO_REV_ID,
                    "the {{ .ProjectKebab }} monorepo",
                )),
                # Re-add the `<name>/` prefix so the standalone root lands under the
                # component directory in the monorepo.
                core.move("", _name),
            ],
        )

# Drive the generator for every component (top-level comprehension, not a `for`).
[_define_component(_c) for _c in COMPONENTS]
