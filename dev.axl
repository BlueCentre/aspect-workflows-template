"""Developer + CI tasks for the template repo itself.

`aspect render-preset --preset <name> --out <dir>` renders a single preset from
the local `template/` tree using the shared renderer + this repo's
`template-config.json`. This is the same renderer `aspect init` uses, so testing
here proves the template renders. It's also what the CI matrix and the
`aspect-starters` publish job invoke.
"""

load("./render.axl", "load_config", "preset_flags", "render")
load("./app.axl", "app_config", "app_flags", "resolve_concerns", "sample_selections", "validate_app_config")

# Backstage presets ship a software-template (template.yaml) whose `skeleton/`
# must contain a concrete copy of the rendered project so Backstage's scaffolder
# can re-emit it. The old engine did this in hooks/post_scaffold; the new renderer
# has no hook, so we replicate it here (the local/CI/delivery render path). Copies
# every rendered file except the Backstage meta files, paths preserved, names
# concrete (only the hand-authored skeleton/* files carry ${{ values.* }}).
_SKELETON_EXCLUDE_TOP = ["template.yaml", "catalog-info.yaml", "skeleton", "README.md", "README.bazel.md"]

def _populate_skeleton(ctx, out, written):
    skel = out + "/skeleton"
    copied = 0
    for rel in written:
        if rel.split("/")[0] in _SKELETON_EXCLUDE_TOP:
            continue
        dst = skel + "/" + rel
        if ctx.std.fs.exists(dst):
            continue
        ctx.std.fs.create_dir_all(dst.rsplit("/", 1)[0])
        ctx.std.fs.copy(out + "/" + rel, dst)
        copied += 1
    ctx.std.io.stdout.write("  backstage: copied {} files into skeleton/\n".format(copied))

def _impl(ctx):
    repo_dir = ctx.std.env.current_dir()
    config = load_config(ctx, repo_dir)

    preset = ctx.args.preset
    out = ctx.args.out
    name = ctx.args.name

    flags = dict(preset_flags(config, preset))
    # Mirror `aspect init`'s --license: defaults to "none"; the aspect-starters
    # publish job passes --license=Apache-2.0 to include it.
    flags["license"] = ctx.args.license != "none"
    template_dir = repo_dir + "/template"

    if ctx.std.fs.exists(out):
        ctx.std.fs.remove_dir_all(out)
    ctx.std.fs.create_dir_all(out)

    written = render(ctx, config, template_dir, out, name, flags)
    ctx.std.io.stdout.write("rendered preset {!r} -> {} ({} files)\n".format(preset, out, len(written)))

    if flags.get("backstage", False):
        _populate_skeleton(ctx, out, written)

    return 0

# NB: --preset has no static `values=` list because the valid presets are read
# at runtime from template-config.json (preset_flags fails on an unknown name).
render_preset = task(
    kind = "render-preset",
    summary = "Render one template preset into an output directory",
    implementation = _impl,
    args = {
        "preset": args.string(required = True, description = "Preset to render (see template-config.json)"),
        "out": args.string(required = True, description = "Output directory (cleared if it exists)"),
        "name": args.string(default = "my_project", description = "Project name (snake_case)"),
        "license": args.string(default = "none", values = ["Apache-2.0", "none"], description = "License to scaffold; defaults to 'none'. Pass 'Apache-2.0' to include it."),
    },
)

def _check_metadata_impl(ctx):
    repo_dir = ctx.std.env.current_dir()
    config = load_config(ctx, repo_dir)
    problems = validate_app_config(config)
    if problems:
        ctx.std.io.stdout.write("check-metadata: {} problem(s)\n".format(len(problems)))
        for p in problems:
            ctx.std.io.stdout.write("  - {}\n".format(p))
        fail("application metadata contract is invalid")
    ctx.std.io.stdout.write("check-metadata: OK\n")
    return 0

check_metadata = task(
    kind = "check-metadata",
    summary = "Validate the application metadata contract in template-config.json",
    implementation = _check_metadata_impl,
    args = {},
)

# --- the gazelle contract ----------------------------------------------------
#
# gazelle owns a stamped application's BUILD file the moment it lands, so the
# file we write has to be exactly what gazelle would generate -- otherwise the
# first `aspect gazelle` run in the host monorepo rewrites it and the stamping
# PR arrives red against that repo's stale-BUILD gate.
#
# Two of gazelle's Go conventions are properties of the DESTINATION, not of the
# application, so neither can be guessed inside the template:
#
#   * target names come from the directory the package sits in, verbatim
#     (app/payments_api -> payments_api_lib, payments_api, payments_api_test).
#     Guessing kebab-case there does not merely rename the targets -- gazelle
#     ADDS its own go_library/go_test beside them and re-points the go_binary,
#     leaving two libraries over the same srcs.
#   * importpath is the host module's path joined with the package's path
#     relative to that module (example.com/my_project + app/payments), so it
#     depends on the monorepo being stamped into and on where in it the
#     application lands -- `app/`, `services/`, anywhere.
#
# Both are therefore computed here from --out and handed to the template as one
# `import_path` value, and the directory-name rule is enforced rather than
# hoped for.

def _absolute(ctx, path):
    if path.startswith("/"):
        return path
    return ctx.std.env.current_dir() + "/" + path

def _path_segments(path):
    segs = []
    for s in path.split("/"):
        if s == "" or s == ".":
            continue
        if s == "..":
            if segs:
                segs.pop()
            continue
        segs.append(s)
    return segs

def _host_module(ctx, out_abs, name):
    """Return (module_path, package_path) for the monorepo --out lands in.

    Walks up from --out for the nearest go.mod -- that directory is the host
    module root, and everything below it is the package path gazelle will use.
    Falls back to the self-contained `example.com/<name>` + `app/<name>` shape
    when there is no go.mod above --out (rendering to a scratch dir).
    """
    segs = _path_segments(out_abs)
    rel = []
    for _ in range(len(segs) + 1):
        if not segs:
            break
        gomod = "/" + "/".join(segs) + "/go.mod"
        if ctx.std.fs.exists(gomod):
            for line in ctx.std.fs.read_to_string(gomod).split("\n"):
                line = line.strip()
                if line.startswith("module "):
                    return (line[len("module "):].strip(), "/".join(rel))
            break
        rel.insert(0, segs.pop())
    return ("example.com/" + name, "app/" + name)

def _render_app_impl(ctx):
    repo_dir = ctx.std.env.current_dir()
    config = load_config(ctx, repo_dir)

    problems = validate_app_config(config)
    if problems:
        for p in problems:
            ctx.std.io.stdout.write("  - {}\n".format(p))
        fail("application metadata contract is invalid; run `aspect check-metadata`")
    app = app_config(config)

    language = ctx.args.language
    requested = [c for c in ctx.args.concerns.split(",") if c]
    concerns = resolve_concerns(app, language, requested)

    target_name = ctx.args.deploy_target
    if target_name not in app["deploy_targets"]:
        fail("unknown deploy target {!r}; known: {}".format(target_name, ", ".join(sorted(app["deploy_targets"].keys()))))
    target = app["deploy_targets"][target_name]

    db_provider = ctx.args.db_provider
    if db_provider == "":
        db_provider = target["default_db_provider"]
    if db_provider not in target["db_providers"]:
        fail("db provider {!r} is not available on deploy target {!r}; available: {}".format(
            db_provider, target_name, ", ".join(target["db_providers"])))

    framework = ctx.args.http_framework
    fw = app.get("http_frameworks", {}).get(language)
    if fw:
        if framework == "":
            framework = fw["default"]
        if framework not in fw["options"]:
            fail("http framework {!r} is not available for {!r}; available: {}".format(
                framework, language, ", ".join(fw["options"])))

    flags = app_flags(app, language, concerns, framework, target_name, db_provider)

    # See "the gazelle contract" above: the BUILD file's target names and
    # importpath are properties of where the application lands, so resolve them
    # from --out before rendering.
    out_abs = _absolute(ctx, ctx.args.out)
    out_base = _path_segments(out_abs)[-1]
    if out_base != ctx.args.name:
        fail(("--out must end in a directory named after the application: gazelle names Go " +
              "targets after the directory, so stamping {!r} into .../{} produces a BUILD file " +
              "gazelle immediately rewrites. Use --out=.../{}").format(ctx.args.name, out_base, ctx.args.name))
    module_path, package_path = _host_module(ctx, out_abs, ctx.args.name)
    if ctx.args.module_path != "":
        module_path = ctx.args.module_path
    flags["import_path"] = module_path + "/" + package_path

    # The app section carries its own rules/no_render/executable because globs are
    # matched relative to the template_dir passed below, not to template/.
    app_render_config = {
        "rules": app["rules"],
        "no_render": app["no_render"],
        "executable": app["executable"],
    }
    template_dir = repo_dir + "/template/" + app["languages"][language]["template_dir"]

    out = ctx.args.out
    if ctx.std.fs.exists(out):
        ctx.std.fs.remove_dir_all(out)
    ctx.std.fs.create_dir_all(out)

    written = render(ctx, app_render_config, template_dir, out, ctx.args.name, flags)
    ctx.std.io.stdout.write("rendered {} app {!r} [{}] -> {} ({} files)\n".format(
        language, ctx.args.name, ", ".join(concerns) if concerns else "no concerns", out, len(written)))
    return 0

render_app = task(
    kind = "render-app",
    summary = "Render one application into an output directory",
    implementation = _render_app_impl,
    args = {
        "language": args.string(required = True, description = "Language (see template-config.json app.languages)"),
        "name": args.string(required = True, description = "Application name (snake_case)"),
        "out": args.string(required = True, description = "Output directory (cleared if it exists)"),
        "concerns": args.string(default = "", description = "Comma-separated concerns; requires are added automatically"),
        "deploy_target": args.string(default = "homelab", description = "Deploy target (see app.deploy_targets)"),
        "db_provider": args.string(default = "", description = "Database provider; defaults to the target's default"),
        "http_framework": args.string(default = "", description = "HTTP framework; defaults to the language's default"),
        "module_path": args.string(default = "", description = "Host Go module path; defaults to the module declared by the nearest go.mod above --out"),
    },
)

# The project name tier 2 stamps every sampled selection under.
_SMOKE_NAME = "smoke_app"

def _check_renders_impl(ctx):
    repo_dir = ctx.std.env.current_dir()
    config = load_config(ctx, repo_dir)
    problems = validate_app_config(config)
    if problems:
        for p in problems:
            ctx.std.io.stdout.write("  - {}\n".format(p))
        fail("application metadata contract is invalid; run `aspect check-metadata`")
    app = app_config(config)

    app_render_config = {"rules": app["rules"], "no_render": app["no_render"], "executable": app["executable"]}
    base_out = ctx.args.out_dir
    if ctx.std.fs.exists(base_out):
        ctx.std.fs.remove_dir_all(base_out)

    failures = []
    checked = 0
    for sel in sample_selections(app):
        language = sel[0]
        concerns = resolve_concerns(app, language, sel[1])
        label = sel[2]
        target = app["deploy_targets"]["homelab"]
        fw = app.get("http_frameworks", {}).get(language)
        flags = app_flags(app, language, concerns,
                          fw["default"] if fw else "",
                          "homelab", target["default_db_provider"])

        # render-app resolves import_path from the host monorepo (see "the
        # gazelle contract"); tier 2 renders into a scratch dir with no host, so
        # it supplies the same key with the no-host fallback shape. Without it
        # the templates would emit an empty importpath and the smoke would pass
        # on output that could never build.
        flags["import_path"] = "example.com/" + _SMOKE_NAME + "/app/" + _SMOKE_NAME
        out = base_out + "/" + language + "-" + str(checked)
        ctx.std.fs.create_dir_all(out)
        template_dir = repo_dir + "/template/" + app["languages"][language]["template_dir"]
        written = render(ctx, app_render_config, template_dir, out, _SMOKE_NAME, flags)

        if not written:
            failures.append("{} [{}]: rendered zero files".format(label, language))
        for rel in written:
            content = ctx.std.fs.read_to_string(out + "/" + rel)
            if "{{" in content or "{%" in content:
                failures.append("{} [{}]: {} still contains unrendered Jinja".format(label, language, rel))
            if _SMOKE_NAME not in content and rel == "BUILD.bazel":
                failures.append("{} [{}]: BUILD.bazel never substituted the project name".format(label, language))
        checked += 1

    ctx.std.io.stdout.write("check-renders: {} selection(s) rendered\n".format(checked))
    if failures:
        for f in failures:
            ctx.std.io.stdout.write("  - {}\n".format(f))
        fail("{} render problem(s)".format(len(failures)))
    ctx.std.io.stdout.write("check-renders: OK\n")
    return 0

check_renders = task(
    kind = "check-renders",
    summary = "Render sampled valid selections and assert each output is clean",
    implementation = _check_renders_impl,
    args = {
        "out_dir": args.string(default = "/tmp/aspect-check-renders", description = "Scratch directory for rendered output"),
    },
)
